{
  "schema": "repository_layout@1",
  "root_files": [
    "README.md",
    "LICENSE",
    "NOTICE",
    "CITATION.cff",
    "pyproject.toml",
    ".gitignore",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "directories": {
    "src": {
      "purpose": "Native Codex reader, local setup helper, provider conversation parsers, views, MCP adapter and production index builder",
      "guide": "docs/development.md"
    },
    "tests": {
      "purpose": "Regression and provenance tests"
    },
    "examples": {
      "purpose": "Selected native records, current MCP responses, retrieval measurements and retained legacy parser regressions",
      "guide": "examples/README.md"
    },
    "tools": {
      "purpose": "Native MCP checks, retrieval measurements, compatibility replay, example regeneration and layout checks"
    },
    "docs": {
      "purpose": "Mechanism, production excerpts, provenance, layout policy, app screenshots and explanatory diagrams"
    },
    ".github": {
      "purpose": "Public CI verification"
    },
    "skills": {
      "purpose": "Portable agent instructions and complete installable references",
      "guide": "skills/agent-trace/SKILL.md"
    }
  },
  "required_files": [
    "README.md",
    "LICENSE",
    "pyproject.toml",
    "docs/provenance.json",
    "docs/repository_layout.json",
    "src/trace_mechanism/parser.py",
    "tools/check_layout.py",
    "src/trace_mechanism/mcp_server.py",
    "src/trace_mechanism/structurer.mjs",
    "tools/regenerate_examples.py",
    "docs/codex-retrieval.md",
    "src/trace_mechanism/codex_native.py",
    "docs/mcp.md",
    "examples/native-command.jsonl",
    "examples/native-command-response.json",
    "tools/record_native_contract.py",
    "CONTRIBUTING.md",
    "examples/README.md",
    "tools/check_distribution.py",
    "skills/agent-trace/SKILL.md",
    "skills/agent-trace/references/install.md",
    "tools/install_skill.py",
    "docs/workbench.md",
    "src/trace_mechanism/workbench/index.html",
    "src/trace_mechanism/workbench/server.py",
    "src/trace_mechanism/workbench/desktop.py",
    "tools/build_macos_app.py",
    "skills/agent-trace/references/workbench.md"
  ],
  "content_routes": {
    "README.md": [
      "docs/development.md",
      "docs/provenance.json",
      "CONTRIBUTING.md",
      "examples/README.md",
