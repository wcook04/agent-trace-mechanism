{
  "schema": "repository_layout@1",
  "root_files": [
    "README.md",
    "LICENSE",
    "pyproject.toml",
    ".gitignore",
    "SECURITY.md"
  ],
  "directories": {
    "src": {
      "purpose": "Standalone parsing package"
    },
    "tests": {
      "purpose": "Regression and provenance tests"
    },
    "examples": {
      "purpose": "Synthetic fixtures and a selected controlled agent run with rendered outputs"
    },
    "tools": {
      "purpose": "Repository maintenance checks"
    },
    "docs": {
      "purpose": "Mechanism, production excerpts, provenance and layout policy"
    },
    ".github": {
      "purpose": "Public CI verification"
    }
  },
  "required_files": [
    "README.md",
    "LICENSE",
    "pyproject.toml",
    "docs/provenance.json",
    "docs/repository_layout.json",
    "src/trace_mechanism/parser.py",
    "tools/check_layout.py"
  ],
  "content_routes": {
    "README.md": [
      "tools/check_layout.py",
      "docs/provenance.json"
    ]
  },
  "exceptions": {}
}
